@baseUrl = http://localhost:5080

### 1. Создать заявку с новым владельцем и сроком через час
< {%
    client.global.clear("requestId");
    client.global.clear("credentialUrl");
    request.variables.set("newOwnerName",
        "Owner." + Date.now().toString(36) + "." + Math.random().toString(36).slice(2, 6));
    request.variables.set("validUntil", new Date(Date.now() + 60 * 60 * 1000).toISOString());
%}
POST {{baseUrl}}/requests
Content-Type: application/json

{
  "ownerName": "{{newOwnerName}}",
  "validUntil": "{{validUntil}}"
}

> {%
    client.test("Заявка принята", function () {
        client.assert(response.status === 202, "Ожидается 202 Accepted");
    });
    if (response.status === 202) {
        client.global.set("requestId", response.body.id);
    }
%}

### 2. Читать заявку; повторять до Issued (обход каждые 10 секунд)
GET {{baseUrl}}/requests/{{requestId}}

> {%
    client.test("Карточка заявки получена", function () {
        client.assert(response.status === 200, "Ожидается 200 OK");
    });
    if (response.status === 200 && response.body.status === "Issued") {
        client.global.set("credentialUrl", response.body.credentialUrl);
        client.log("Удостоверение готово; выполните запрос 3.");
    } else {
        client.global.clear("credentialUrl");
        client.log("Повторите запрос 2 после следующего обхода. Статус: " + response.body.status);
    }
%}

### 3. Получить удостоверение по ссылке из заявки
< {%
    if (!client.global.get("credentialUrl")) {
        throw new Error("Сначала повторите запрос 2 до статуса Issued.");
    }
%}
GET {{baseUrl}}{{credentialUrl}}

> {%
    client.test("Удостоверение получено", function () {
        client.assert(response.status === 200, "Ожидается 200 OK");
    });
%}
